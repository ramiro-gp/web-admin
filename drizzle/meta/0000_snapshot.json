          "value": "\"additional_works\".\"status\" IN ('requested', 'in_progress', 'completed', 'cancelled')"
        },
        "additional_works_currency": {
          "name": "additional_works_currency",
          "value": "\"additional_works\".\"currency\" IN ('ARS', 'USD')"
        },
        "additional_works_price_nonnegative": {
