# Runtime: Neon pooled URL. Never use production credentials in a preview.
DATABASE_URL=
# Direct URL for migrations, seeds and backup/restore.
DIRECT_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Immutable numeric ID of the only authorized GitHub account.
ADMIN_GITHUB_ID=
# Optional local password for encrypted backup files (at least 16 characters).
BACKUP_PASSWORD=
